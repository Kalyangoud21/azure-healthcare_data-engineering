{
	"name": "pl_orchestrate_healthcare_files",
	"properties": {
		"activities": [
			{
				"name": "NB_Get_File_Metadata",
				"type": "DatabricksNotebook",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/HC/azure-healthcare_data-engineering/databricks/bronze/02_file_control_orchestration"
				},
				"linkedServiceName": {
					"referenceName": "ls_databricks_healthcare",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "FE_Process_Healthcare_Files",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "NB_Get_File_Metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('NB_Get_File_Metadata').output.runOutput.files",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "NB_Claim_File",
							"type": "DatabricksNotebook",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"notebookPath": "/HC/azure-healthcare_data-engineering/databricks/bronze/03_file_claim_orchestration",
								"baseParameters": {
									"file_id": {
										"value": "@item().file_id",
										"type": "Expression"
									},
									"adf_run_id": "@pipeline().RunId"
								}
							},
							"linkedServiceName": {
								"referenceName": "ls_databricks_healthcare",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "NB_Bronze_Ingestion",
							"type": "DatabricksNotebook",
							"dependsOn": [
								{
									"activity": "CP_Landing_To_Bronze",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"notebookPath": "/HC/azure-healthcare_data-engineering/databricks/bronze/01_healthcare_bronze_ingestion",
								"baseParameters": {
									"file_id": {
										"value": "@item().file_id",
										"type": "Expression"
									},
									"adf_run_id": {
										"value": "@item().RunId",
										"type": "Expression"
									},
									"batch_id": "@item().batch_id",
									"source_container": "@item().source_container",
									"source_folder": "@item().source_folder",
									"file_name": "@t",
									"storage_account": "sthealthcarede2026",
									"load_type": "@i",
									"target_schema": "bronze",
									"target_table": "patients_raw"
								}
							},
							"linkedServiceName": {
								"referenceName": "ls_databricks_healthcare",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "CP_Landing_To_Bronze",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "NB_Claim_File",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "BinarySource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true
									},
									"formatSettings": {
										"type": "BinaryReadSettings"
									}
								},
								"sink": {
									"type": "BinarySink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "ds_adls_landing_binary",
									"type": "DatasetReference",
									"parameters": {
										"p_directory": {
											"value": "@item().source_folder",
											"type": "Expression"
										},
										"p_filename": {
											"value": "@item().file_name",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_adls_bronze_binary",
									"type": "DatasetReference",
									"parameters": {
										"p_directory": {
											"value": "@item().source_folder",
											"type": "Expression"
										},
										"p_filename": {
											"value": "@item().file_name",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"annotations": []
	}
}