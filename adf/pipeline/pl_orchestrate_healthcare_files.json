{
	"name": "pl_orchestrate_healthcare_files",
	"properties": {
		"activities": [
			{
				"name": "NB_Get_File_Metadata",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "NB_Register_landing_files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/HC/azure-healthcare_data-engineering/databricks/bronze/02_file_control_orchestration"
				},
				"linkedServiceName": {
					"referenceName": "ls_databricks_healthcare",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "FE_Process_Healthcare_Files",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "NB_Get_File_Metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('NB_Get_File_Metadata').output.runOutput.files",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "NB_Claim_File",
							"type": "DatabricksNotebook",
							"dependsOn": [
								{
									"activity": "GM_Check_Bronze_File",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"notebookPath": "/HC/azure-healthcare_data-engineering/databricks/bronze/03_file_claim_orchestration",
								"baseParameters": {
									"file_id": {
										"value": "@item().file_id",
										"type": "Expression"
									},
									"adf_run_id": {
										"value": "@pipeline().RunId",
										"type": "Expression"
									},
									"bronze_file_exists": {
										"value": "@string(activity('GM_Check_Bronze_File').output.exists)",
										"type": "Expression"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "ls_databricks_healthcare",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "IF_Claim_Success",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "NB_Claim_File",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@and(\n    equals(activity('NB_Claim_File').output.runOutput.claim_success, true),\n    equals(activity('GM_Check_Bronze_File').output.exists, false)\n)",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "FAIL_File_Claim",
										"type": "Fail",
										"dependsOn": [],
										"userProperties": [],
										"typeProperties": {
											"message": "File processing blocked. Either the file claim was unsuccessful or the destination file already exists in Bronze. Copy and ingestion were not executed.",
											"errorCode": "FILE_PROCESSING_GUARD_FAILED"
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "CP_Landing_To_Bronze",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [
											{
												"name": "FileName",
												"value": "@item().file_name"
											},
											{
												"name": "SourceFolder",
												"value": "@item().source_folder"
											},
											{
												"name": "BatchId",
												"value": "@item().batch_id"
											}
										],
										"typeProperties": {
											"source": {
												"type": "BinarySource",
												"storeSettings": {
													"type": "AzureBlobFSReadSettings",
													"recursive": true
												},
												"formatSettings": {
													"type": "BinaryReadSettings"
												}
											},
											"sink": {
												"type": "BinarySink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												}
											},
											"enableStaging": false
										},
										"inputs": [
											{
												"referenceName": "ds_adls_landing_binary",
												"type": "DatasetReference",
												"parameters": {
													"p_directory": {
														"value": "@item().source_folder",
														"type": "Expression"
													},
													"p_filename": {
														"value": "@item().file_name",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "ds_adls_bronze_binary",
												"type": "DatasetReference",
												"parameters": {
													"p_directory": {
														"value": "@item().source_folder",
														"type": "Expression"
													},
													"p_filename": {
														"value": "@item().file_name",
														"type": "Expression"
													}
												}
											}
										]
									},
									{
										"name": "NB_Bronze_Ingestion",
										"type": "DatabricksNotebook",
										"dependsOn": [
											{
												"activity": "CP_Landing_To_Bronze",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [
											{
												"name": "FileName",
												"value": "@item().file_name"
											},
											{
												"name": "SourceFolder",
												"value": "@item().source_folder"
											},
											{
												"name": "BatchId",
												"value": "@item().batch_id"
											}
										],
										"typeProperties": {
											"notebookPath": "/HC/azure-healthcare_data-engineering/databricks/bronze/01_healthcare_bronze_ingestion",
											"baseParameters": {
												"file_id": {
													"value": "@item().file_id",
													"type": "Expression"
												},
												"adf_run_id": {
													"value": "@pipeline().RunId",
													"type": "Expression"
												},
												"batch_id": {
													"value": "@item().batch_id",
													"type": "Expression"
												},
												"source_container": {
													"value": "@item().source_container",
													"type": "Expression"
												},
												"source_folder": {
													"value": "@item().source_folder",
													"type": "Expression"
												},
												"file_name": {
													"value": "@item().file_name",
													"type": "Expression"
												},
												"storage_account": "sthealthcarede2026",
												"load_type": {
													"value": "@item().load_type",
													"type": "Expression"
												},
												"target_schema": "bronze",
												"target_table": "patients_raw"
											}
										},
										"linkedServiceName": {
											"referenceName": "ls_databricks_healthcare",
											"type": "LinkedServiceReference"
										}
									},
									{
										"name": "NB_Silver_LoadDimPatients",
										"type": "DatabricksNotebook",
										"dependsOn": [
											{
												"activity": "NB_Bronze_Ingestion",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"notebookPath": "/HC/azure-healthcare_data-engineering/databricks/silver/01_silver_load_dimpatients",
											"baseParameters": {
												"file_id": {
													"value": "@item().file_id",
													"type": "Expression"
												},
												"adf_run_id": {
													"value": "@pipeline().RunId",
													"type": "Expression"
												}
											}
										},
										"linkedServiceName": {
											"referenceName": "ls_databricks_healthcare",
											"type": "LinkedServiceReference"
										}
									},
									{
										"name": "EP_Process_Gold",
										"type": "ExecutePipeline",
										"dependsOn": [
											{
												"activity": "NB_Silver_LoadDimPatients",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"pipeline": {
												"referenceName": "pl_process_gold",
												"type": "PipelineReference"
											},
											"waitOnCompletion": true,
											"parameters": {
												"p_file_id": {
													"value": "@item().p_file_id",
													"type": "Expression"
												},
												"p_adf_run_id": {
													"value": "@pipeline().RunId",
													"type": "Expression"
												}
											}
										}
									},
									{
										"name": "CP_Archeive_Processed_File",
										"type": "Copy",
										"dependsOn": [
											{
												"activity": "GM_Check_Archive_Exists",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "BinarySource",
												"storeSettings": {
													"type": "AzureBlobFSReadSettings",
													"recursive": false,
													"deleteFilesAfterCompletion": false
												},
												"formatSettings": {
													"type": "BinaryReadSettings"
												}
											},
											"sink": {
												"type": "BinarySink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												}
											},
											"enableStaging": false,
											"skipErrorFile": {
												"dataInconsistency": false
											},
											"validateDataConsistency": true
										},
										"inputs": [
											{
												"referenceName": "ds_adls_landing_binary",
												"type": "DatasetReference",
												"parameters": {
													"p_directory": {
														"value": "@item().source_folder",
														"type": "Expression"
													},
													"p_filename": {
														"value": "@item().file_name",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "ds_adls_landing_binary",
												"type": "DatasetReference",
												"parameters": {
													"p_directory": {
														"value": "archive/patients",
														"type": "Expression"
													},
													"p_filename": {
														"value": "@item().file_name",
														"type": "Expression"
													}
												}
											}
										]
									},
									{
										"name": "GM_Check_Archive_Exists",
										"type": "GetMetadata",
										"dependsOn": [
											{
												"activity": "EP_Process_Gold",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"dataset": {
												"referenceName": "ds_adls_landing_binary",
												"type": "DatasetReference",
												"parameters": {
													"p_directory": {
														"value": "archive/patients",
														"type": "Expression"
													},
													"p_filename": {
														"value": "@item().file_name",
														"type": "Expression"
													}
												}
											},
											"fieldList": [
												"exists"
											],
											"storeSettings": {
												"type": "AzureBlobFSReadSettings",
												"enablePartitionDiscovery": false
											},
											"formatSettings": {
												"type": "BinaryReadSettings"
											}
										}
									}
								]
							}
						},
						{
							"name": "GM_Check_Bronze_File",
							"type": "GetMetadata",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "ds_adls_bronze_binary",
									"type": "DatasetReference",
									"parameters": {
										"p_directory": {
											"value": "@item().source_folder",
											"type": "Expression"
										},
										"p_filename": {
											"value": "@item().file_name",
											"type": "Expression"
										}
									}
								},
								"fieldList": [
									"exists"
								],
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "BinaryReadSettings"
								}
							}
						}
					]
				}
			},
			{
				"name": "GM_Discover_Landing_Files",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_adls_landing_folder",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "NB_Register_landing_files",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "GM_Discover_Landing_Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/HC/azure-healthcare_data-engineering/databricks/bronze/04_register_landing_files",
					"baseParameters": {
						"storage_account": "sthealthcarede2026",
						"source_container": "landing",
						"source_folder": "patients",
						"discovered_files_json": {
							"value": "@string(activity('GM_Discover_Landing_Files').output.childItems)",
							"type": "Expression"
						},
						"adf_run_id": {
							"value": "@pipeline().RunId",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_databricks_healthcare",
					"type": "LinkedServiceReference"
				}
			}
		],
		"concurrency": 1,
		"variables": {
			"bronze_file_exists": {
				"type": "Boolean",
				"defaultValue": false
			},
			"file_claim_success": {
				"type": "Boolean",
				"defaultValue": false
			}
		},
		"annotations": []
	}
}